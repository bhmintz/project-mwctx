+#if PAN_ARCH < 9
+/* nfsmw: replace a fragment shader's binary with ARM's (panvk_nfsmw_arm.h). Mesa's compile of the same shader
+ * stays for everything ARM's package does not describe (blend, early-ZS, discard); this swaps the code and what
+ * the renderer state and the varying table take from it. */
+static void
+nfsmw_arm_message(uint16_t v, struct bifrost_message_preload *msg)
+{
+   /* Message Preload in genxml v7: type (0-3), then LD_VAR or VAR_TEX fields. */
+   const unsigned type = v & 0xf;
+   *msg = (struct bifrost_message_preload){0};
+   msg->enabled = type != 0;
+   msg->texture = type == 2;
+   msg->fp16 = ((v >> 9) & 3) == 1;
+   if (msg->texture) {
+      msg->varying_index = (v >> 4) & 0x7;
+      msg->texture_index = (v >> 7) & 0x3;
+      msg->skip = (v >> 14) & 1;
+      msg->zero_lod = (v >> 15) & 1;
+   } else {
+      msg->varying_index = (v >> 4) & 0x1f;
+      msg->num_components = ((v >> 11) & 3) + 1;
+   }
+}
+
+static void
+nfsmw_arm_apply(struct panvk_shader_variant *shader, const struct nfsmw_arm *arm)
+{
+   struct pan_shader_info *info = &shader->info;
+
+   shader->nfsmw_arm = arm;
+   info->work_reg_count = arm->work_reg_count;
+   info->preload = arm->preload;
+   /* ARM's clauses wait on slots 6 and 7 before ATEST and BLEND, so the renderer state must say so. */
+   info->bifrost.wait_6 = true;
+   info->bifrost.wait_7 = true;
+   nfsmw_arm_message(arm->message_preload[0], &info->bifrost.messages[0]);
+   nfsmw_arm_message(arm->message_preload[1], &info->bifrost.messages[1]);
+   /* The renderer state preloads info->fau.count words: all of what the pilot writes, which carries the
+    * texture operation descriptors ARM's TEXC reads. */
+   info->fau.count = arm->fau_words;
+   shader->fau.total_count = DIV_ROUND_UP(arm->fau_words, 2);
+   info->ubo_count = arm->ubo_table_count;
+   /* The draw points the sampler table one entry early: ARM's sampler indices are the game's heap index plus
+    * one (its TEXC takes them from staging registers, sampler then texture); texture indices are the heap's. */
+   info->sampler_count += 1;
+
+   /* The fragment inputs in ARM's order: LD_VAR's index is the slot. */
+   const struct pan_varying_layout old = info->varyings.formats;
+   struct pan_varying_layout *l = &info->varyings.formats;
+   l->count = arm->varying_count;
+   for (unsigned i = 0; i < arm->varying_count; i++) {
+      const struct pan_varying_slot *slot =
+         pan_varying_layout_find_slot(&old, arm->varyings[i].location);
+      if (slot) {
+         l->slots[i] = *slot;
+      } else {
+         l->slots[i] = (struct pan_varying_slot){0};
+         l->slots[i].location = arm->varyings[i].location;
+         l->slots[i].alu_type = nir_type_float32;
+         l->slots[i].ncomps = arm->varyings[i].ncomps;
+         l->slots[i].section = PAN_VARYING_SECTION_GENERIC;
+         l->slots[i].offset = -1;
+      }
+   }
+
+   free((void *)shader->bin_ptr);
+   /* Zeros after the last clause, as Mesa's compiler leaves them: the shader core prefetches 128 bytes. */
+   void *code = calloc(1, arm->code_size + 128);
+   memcpy(code, arm->code, arm->code_size);
+   shader->bin_ptr = code;
+   shader->bin_size = arm->code_size + 128;
+}
