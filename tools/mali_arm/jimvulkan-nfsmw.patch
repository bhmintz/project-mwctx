+/* nfsmw: a fragment shader with ARM's binary (panvk_nfsmw_arm.h). Builds its uniform buffer table in ARM's
+ * layout from the bound descriptor sets and runs its pilot on the CPU, which fills the push uniforms. */
+static VkResult
+nfsmw_arm_prepare_fs(struct panvk_cmd_buffer *cmdbuf, const struct panvk_shader_variant *fs)
+{
+   const struct nfsmw_arm *arm = fs->nfsmw_arm;
+   const struct panvk_descriptor_state *desc_state = &cmdbuf->state.gfx.desc_state;
+   static bool avisado;
+
+   struct pan_ptr ubos =
+      panvk_cmd_alloc_desc_array(cmdbuf, MAX2(arm->ubo_table_count, 1), UNIFORM_BUFFER);
+   if (!ubos.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   memset(ubos.cpu, 0, MAX2(arm->ubo_table_count, 1) * pan_size(UNIFORM_BUFFER));
+
+   struct mali_uniform_buffer_packed *table = ubos.cpu;
+   for (unsigned i = 0; i < arm->ubo_count; i++) {
+      const unsigned set_idx = arm->ubos[i].set;
+      const struct panvk_descriptor_set *set = set_idx < MAX_SETS ? desc_state->sets[set_idx] : NULL;
+      if (!set || arm->ubos[i].binding >= set->layout->binding_count ||
+          arm->ubos[i].slot >= arm->ubo_table_count)
+         continue;
+      const struct panvk_descriptor_set_binding_layout *bl =
+         &set->layout->bindings[arm->ubos[i].binding];
+      if (bl->type != VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC) {
+         if (!avisado)
+            mesa_loge("nfsmw: UBO de ARM en set %u binding %u no es dinamico", set_idx,
+                      arm->ubos[i].binding);
+         avisado = true;
+         continue;
+      }
+      const uint64_t addr = set->dyn_bufs[bl->desc_idx].dev_addr +
+                            desc_state->dyn_buf_offsets[set_idx][bl->desc_idx];
+      pan_pack(&table[arm->ubos[i].slot], UNIFORM_BUFFER, cfg) {
+         cfg.pointer = addr;
+         cfg.entries = DIV_ROUND_UP(set->dyn_bufs[bl->desc_idx].size, 16);
+      }
+   }
+   cmdbuf->state.gfx.fs.nfsmw_ubos = ubos.gpu;
+
+   struct pan_ptr push =
+      panvk_cmd_alloc_dev_mem(cmdbuf, desc, ALIGN_POT(arm->fau_words * 4, 8), sizeof(uint64_t));
+   if (!push.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   if (!nfsmw_arm_run_pilot(arm, ubos.gpu, ubos.cpu, push.cpu) && !avisado) {
+      mesa_loge("nfsmw: el piloto de %016" PRIx64 " no termino", arm->hash);
+      avisado = true;
+   }
+   cmdbuf->state.gfx.fs.push_uniforms = push.gpu;
+
+   /* The first blocks, to check them against what the pilot gives on the PC. */
+   static unsigned registrados;
+   if (registrados < 8) {
+      registrados++;
+      const uint32_t *w = push.cpu;
+      char texto[16 * 9 + 1] = "";
+      for (unsigned i = 0; i < MIN2(arm->fau_words, 16); i++)
+         snprintf(texto + i * 9, 10, " %08x", w[i]);
+      mesa_logi("nfsmw: piloto %016" PRIx64 " ubos %" PRIx64 ":%s", arm->hash, ubos.gpu, texto);
+      for (unsigned i = 0; i < arm->ubo_count; i++) {
+         const uint32_t *u = (const uint32_t *)&((struct mali_uniform_buffer_packed *)ubos.cpu)[arm->ubos[i].slot];
+         mesa_logi("nfsmw:   ubo ranura %u = %08x %08x", arm->ubos[i].slot, u[0], u[1]);
+      }
+   }
+   return VK_SUCCESS;
+}
